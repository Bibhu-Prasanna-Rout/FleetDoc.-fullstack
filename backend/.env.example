APP_NAME=FleetDoc API
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+psycopg://fleetdoc:fleetdoc@localhost:5432/fleetdoc
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# First admin created by seed
ADMIN_NAME=FleetDoc Admin
ADMIN_EMAIL=admin@fleetdoc.com
ADMIN_PASSWORD=Admin@123

# OTP: in development, OTP is returned in the API response. NEVER enable this in production.
DEV_RETURN_OTP=false
OTP_EXPIRE_MINUTES=5
OTP_RESEND_SECONDS=60

# SMTP (Gmail - real email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=fleetdoc.company@gmail.com
SMTP_PASSWORD=hkoi elev qgnj iebh
SMTP_FROM_EMAIL=fleetdoc.company@gmail.com
SMTP_USE_TLS=true

# SMS provider: twilio or msg91
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
META_GRAPH_URL=https://graph.facebook.com/v22.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_ThlKL1ZvQ4Ng9k
RAZORPAY_KEY_SECRET=LO63lZR7C6oEy0nm7E0edG0v
RAZORPAY_WEBHOOK_SECRET=

# Scheduled notification worker
SCHEDULER_ENABLED=true
